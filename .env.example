# Copie para .env na raiz para desenvolvimento local. Em produção, cada variável
# vai nas "Variables" do serviço no Railway (use "Shared Variables" para as comuns).

# ── Comuns (api, mcp, worker) ──
DATABASE_URL=postgres://cerebro:cerebro@localhost:5432/cerebro_dev
# No Railway: DATABASE_URL=${{Postgres.DATABASE_URL}} e DATABASE_SSL=false (rede privada)
DATABASE_SSL=false
NODE_ENV=development
# Endereço público da interface. Tudo (API, MCP, webhook) passa por ele.
URL_WEB=http://localhost:5173
URL_API=http://localhost:5173/api
# Proxies à frente da API/MCP: 1 em dev (Vite); 2 no Railway (borda + servidor da web)
CONFIAR_PROXY=1

# ── Segredos (gere com: openssl rand -base64 48 / openssl rand -base64 32) ──
JWT_SEGREDO=
# Exatamente 32 bytes em base64. Cifra os tokens do Google guardados no banco.
CEREBRO_CHAVE_CIFRA=

# ── IA ──
IA_ANALISE_BASE_URL=https://api.deepseek.com
IA_ANALISE_CHAVE=
IA_ANALISE_MODELO=deepseek-flash
# Opcional: provedor para conteúdo restrito (mesma API compatível com OpenAI)
IA_RESTRITO_BASE_URL=
IA_RESTRITO_CHAVE=
IA_RESTRITO_MODELO=
# Busca semântica (Gemini, plano gratuito)
GEMINI_CHAVE=
EMBEDDINGS_DIMENSOES=768

# Argos consultando o banco da Central (24+ caracteres: letras, números, _ ou -). O Cérebro cria o usuário
# somente leitura argos_leitura e as views sem dados pessoais sozinho, ao subir.
ARGOS_DB_SENHA=

# Voz do Argos (Whisper pela Groq: console.groq.com)
GROQ_CHAVE=
VOZ_BASE_URL=https://api.groq.com/openai/v1
VOZ_MODELO=whisper-large-v3-turbo

# ── Integrações ──
FATHOM_WEBHOOK_SEGREDO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NOTION_TOKEN=
# Caixa dedicada (ex.: cerebro@tutts.com.br). Dados do provedor: Roundcube › Configurações.
IMAP_HOST=
IMAP_PORTA=993
IMAP_SEGURO=true
IMAP_USUARIO=
IMAP_SENHA=
IMAP_PASTA=INBOX

# ── Só no serviço web (Railway) ──
# API_INTERNA_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}
# MCP_INTERNA_URL=http://${{mcp.RAILWAY_PRIVATE_DOMAIN}}:${{mcp.PORT}}

# Voz do Argos gerada no servidor (OpenAI gpt-4o-mini-tts): a mesma voz natural em qualquer aparelho.
# Sem ela, o Argos usa a voz do navegador. A voz e o ritmo se escolhem em Integrações.
OPENAI_CHAVE=
# FALA_MODELO=gpt-4o-mini-tts
