{
  "name": "@cerebro/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "criar-admin": "tsx --env-file-if-exists=../../.env src/cli/criar-admin.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "demo": "tsx --env-file-if-exists=../../.env scripts/demo.ts"
  },
  "dependencies": {
    "@cerebro/auth": "workspace:*",
    "@cerebro/core": "workspace:*",
    "@cerebro/db": "workspace:*",
    "@cerebro/integracoes": "workspace:*",
    "@cerebro/servicos": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "imapflow": "^2.9.1",
    "jose": "^6.2.13",
    "mailparser": "^3.12.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cerebro/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
